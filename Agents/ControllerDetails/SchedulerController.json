          "Common_repo (Repository/Common_repo.cs) via ICommon",
          "Scheduler_repo (Repository/Scheduler_repo.cs) via IScheduler"
        ],
        "stored_procedures": [],
        "sends_notifications": false,
        "depends_on_user_context": "Resolves the current user from the JWT (getUserByToken / claims)",
        "validation_rules": [
          {
            "returns": 401,
            "message": "Unauthorized: Invalid or missing token.",
            "when": "current_user == null"
          },
          {
            "returns": 400,
            "message": "Valid scheduler ID is required.",
            "when": "schedulerId <= 0"
          },
          {
            "returns": 400,
            "message": "At least one field must be provided for update.",
            "when": "!request.CmsId.HasValue && !request.ForUserId.HasValue && request.ScheduledDate == default(DateTime) && string.IsNullOrWhiteSpace(request.Remarks)"
          },
          {
            "returns": 400,
            "message": "message returned by the called service/repository (result.Message)",
            "when": null
          }
        ]
      }
    }
  ]
}
