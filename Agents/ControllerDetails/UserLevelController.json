            "when": "string.IsNullOrWhiteSpace(request.LevelName) && string.IsNullOrWhiteSpace(request.LevelDescription)"
          },
          {
            "returns": 400,
            "message": "message returned by the called service/repository (result.Message)",
            "when": "!result.Success"
          }
        ]
      }
    }
  ]
}
