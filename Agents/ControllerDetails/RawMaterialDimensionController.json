          {
            "returns": 400,
            "message": "Valid dimension ID is required.",
            "when": "id <= 0"
          },
          {
            "returns": 400,
            "message": "At least one field must be provided for update.",
            "when": "string.IsNullOrWhiteSpace(request.DimensionName)"
          },
          {
            "returns": 400,
            "message": "message returned by the called service/repository (result.Message)",
            "when": "!result.Success"
          }
        ]
      }
    }
  ]
}
