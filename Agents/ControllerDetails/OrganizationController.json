            "message": "Unauthorized: No token provided.",
            "when": "current_user == null"
          },
          {
            "returns": 400,
            "message": "Valid Organization ID is required.",
            "when": "id <= 0"
          },
          {
            "returns": 400,
            "message": "message returned by the called service/repository (result.Message)",
            "when": null
          }
        ]
      }
    }
  ]
}
