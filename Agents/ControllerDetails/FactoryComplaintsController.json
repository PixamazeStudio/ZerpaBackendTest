            "when": "request == null"
          },
          {
            "returns": 404,
            "message": "Observation report not found",
            "when": "observationreport == null"
          },
          {
            "returns": 400,
            "message": "Complaints header not found",
            "when": "complaintsHeader == null"
          }
        ]
