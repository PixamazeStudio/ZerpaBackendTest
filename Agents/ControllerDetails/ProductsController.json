        "validations": "ModelState (DTO data-annotation) validation; Invalid data provided.; Valid category ID is required.; Product name is required.; HSN code is required.; Thickness is required.; (+3 more)",
        "side_effects": "AuditLog CREATE (Settings > Product Settings > Products)",
        "calls_services": [
          "ICommon.getUserByToken",
          "IProducts.GetCategoryById",
          "IProducts.IsProductNameDuplicateAsync",
          "IProducts.CreateProductAsync",
          "IProducts.GetCategories",
          "IProducts.GetSizes",
          "IProducts.GetThicknesses",
          "IProducts.GetGrades",
          "ICommon.ToJsonString",
          "ICommon.AddAsync"
        ],
        "calls_repositories": [
          "Common_repo (Repository/Common_repo.cs) via ICommon",
          "Products_repo (Repositories/Products_repo.cs) via IProducts"
        ],
        "stored_procedures": [],
        "sends_notifications": false,
        "depends_on_user_context": "Resolves the current user from the JWT (getUserByToken / claims)",
        "validation_rules": [
          {
            "returns": 401,
            "message": "Unauthorized: No token provided.",
            "when": "current_user == null"
          },
          {
            "returns": 400,
            "message": "Invalid data provided.",
            "when": "!ModelState.IsValid"
          },
          {
            "returns": 400,
            "message": "Valid category ID is required.",
            "when": "request.categoryid <= 0"
          },
          {
            "returns": 400,
            "message": "Product name is required.",
            "when": "string.IsNullOrWhiteSpace(request.productname)"
          },
          {
            "returns": 400,
            "message": "HSN code is required.",
            "when": "string.IsNullOrWhiteSpace(request.hsncode)"
          },
          {
            "returns": 400,
            "message": "Thickness is required.",
            "when": "string.IsNullOrWhiteSpace(request.thickness)"
          },
          {
            "returns": 400,
            "message": "Size is required.",
            "when": "string.IsNullOrWhiteSpace(request.size)"
          },
          {
            "returns": 400,
            "message": "Valid notional area is required.",
            "when": "request.notionalarea <= 0"
          },
          {
            "returns": 400,
            "message": "Category not found.",
            "when": "category == null"
          },
          {
            "returns": 400,
            "message": "Product with this name already exists.",
            "when": "dupcheck"
          },
          {
