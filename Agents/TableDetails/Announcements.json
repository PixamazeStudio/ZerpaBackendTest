    "query_notes": [
      "The database is MySQL/MariaDB; use MySQL syntax and the exact name Announcements (identifiers can be case-sensitive).",
      "Always filter is_deleted = 0 unless deleted records are explicitly requested.",
      "Use COUNT(DISTINCT id) when counting announcement records; joins can duplicate rows.",
      "To resolve names, join on: regionid = Region.id; areaid = Area.id; sub_areaid = SubArea.id; user_levelid = UserLevel.id.",
      "Do not select content, image_path; they are sensitive or may hold very large content."
