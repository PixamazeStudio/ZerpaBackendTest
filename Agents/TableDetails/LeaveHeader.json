  "business_rules": [
    "Deleted records (IsDeleted = 1) should normally be excluded from reporting.",
    "Approval state is tracked with IsApproved, IsRejected; a record with neither flag set is typically still pending.",
    "CreatedDate is the preferred date column for period-based reporting.",
    "Join to Leave Sub Type, Leave Types through the foreign key columns to resolve names."
  ],
