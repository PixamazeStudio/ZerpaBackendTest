  "business_rules": [
    "Deleted records (is_deleted = 1) should normally be excluded from reporting.",
    "Approval state is tracked with is_approved, is_rejected; a record with neither flag set is typically still pending.",
    "created_date is the preferred date column for period-based reporting.",
    "Use total / new_influencer_phase_one for monetary or quantity totals.",
    "Join to Users through the foreign key columns to resolve names."
  ],
  "common_filters": [
    "created_date",
    "userId",
    "is_deleted",
    "is_editable",
    "is_approved"
  ],
  "common_metrics": [
    {
      "name": "Record Count",
      "formula": "COUNT(DISTINCT id)"
    },
    {
      "name": "Total New Influencer Phase One",
      "formula": "SUM(new_influencer_phase_one)"
    },
    {
      "name": "Total New Influencer Phase Two",
      "formula": "SUM(new_influencer_phase_two)"
    },
    {
      "name": "Total New Influencer Phase Three",
      "formula": "SUM(new_influencer_phase_three)"
    },
    {
      "name": "Average New Influencer Phase One per influencer planner header",
      "formula": "SUM(new_influencer_phase_one) / COUNT(DISTINCT id)"
    }
  ],
  "common_queries": [
