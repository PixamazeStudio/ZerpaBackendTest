  "business_rules": [
    "Deleted records (is_deleted = 1) should normally be excluded from reporting.",
    "date is the preferred date column for period-based reporting.",
    "Use credit_amount / debit_amount for monetary or quantity totals.",
    "Columns voucher_type classify the record; check the distinct values before filtering on them.",
