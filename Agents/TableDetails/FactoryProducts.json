      "formula": "COUNT(DISTINCT id)"
    },
    {
      "name": "Total GST",
      "formula": "SUM(GST)"
    },
    {
      "name": "Average Price",
      "formula": "AVG(price)"
    },
    {
      "name": "Average GST per factory product",
      "formula": "SUM(GST) / COUNT(DISTINCT id)"
    }
  ],
