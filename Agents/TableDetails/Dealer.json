    "known_issues": [
      "maximum_outstanding, current_outstanding are stored as floating point, so sums can carry small rounding differences.",
      "discount, maximum_outstanding, current_outstanding are nullable; use COALESCE when summing or comparing."
    ]
  },
  "sample_data": [],
  "llm_instructions": {
    "can_query": true,
    "preferred_date_column": "created_date",
    "preferred_amount_columns": [
      "discount",
      "maximum_outstanding"
    ],
    "default_sort": "created_date DESC",
    "avoid_columns": [
      "phone",
      "address",
      "pan_card_no",
      "shipping_address",
      "account_no",
      "ifsc_code"
    ],
    "query_notes": [
      "The database is MySQL/MariaDB; use MySQL syntax and the exact name Dealer (identifiers can be case-sensitive).",
      "Always filter is_deleted = 0 unless deleted records are explicitly requested.",
      "Use COUNT(DISTINCT id) when counting dealer records; joins can duplicate rows.",
      "Use SUM(discount) for totals of discount.",
      "To resolve names, join on: areaid = Area.id; regionid = Region.id; sub_areaid = SubArea.id.",
      "Do not select phone, address, pan_card_no, shipping_address, account_no, ifsc_code; they are sensitive or may hold very large content."
    ]
  }
