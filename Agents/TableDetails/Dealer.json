  "business_rules": [
    "Deleted records (is_deleted = 1) should normally be excluded from reporting.",
    "created_date is the preferred date column for period-based reporting.",
    "Use discount / maximum_outstanding for monetary or quantity totals.",
    "Join to Area, Region, Sub Area through the foreign key columns to resolve names."
  ],
  "common_filters": [
    "created_date",
    "areaid",
    "regionid",
    "sub_areaid",
    "is_deleted",
    "is_inactive",
    "is_it_branch",
    "dealer_name"
  ],
  "common_metrics": [
    {
      "name": "Record Count",
      "formula": "COUNT(DISTINCT id)"
    },
    {
      "name": "Total Discount",
      "formula": "SUM(discount)"
    },
    {
      "name": "Total Maximum Outstanding",
      "formula": "SUM(maximum_outstanding)"
    },
    {
      "name": "Total Current Outstanding",
      "formula": "SUM(current_outstanding)"
    },
    {
      "name": "Average Discount per dealer",
      "formula": "SUM(discount) / COUNT(DISTINCT id)"
    }
  ],
