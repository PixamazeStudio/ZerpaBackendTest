  "business_rules": [
    "Deleted records (is_deleted = 1) should normally be excluded from reporting.",
    "uploaded_date is the preferred date column for period-based reporting.",
    "Use Sales_Sheet / Sales_Sheet_Na for monetary or quantity totals.",
    "Join to Dealer, Users through the foreign key columns to resolve names."
  ],
  "common_filters": [
    "uploaded_date",
    "uploaded_byId",
    "dealerId",
    "is_deleted",
    "type_name"
  ],
  "common_metrics": [
    {
      "name": "Record Count",
      "formula": "COUNT(DISTINCT Id)"
    },
    {
      "name": "Total Sales Sheet",
      "formula": "SUM(Sales_Sheet)"
    },
    {
      "name": "Total Sales Sheet Na",
      "formula": "SUM(Sales_Sheet_Na)"
    },
    {
      "name": "Average Sales Sheet per secondary sale",
      "formula": "SUM(Sales_Sheet) / COUNT(DISTINCT Id)"
    }
  ],
