    ],
    "query_notes": [
      "The database is MySQL/MariaDB; use MySQL syntax and the exact name SecondarySales (identifiers can be case-sensitive).",
      "Always filter is_deleted = 0 unless deleted records are explicitly requested.",
      "Use COUNT(DISTINCT Id) when counting secondary sale records; joins can duplicate rows.",
      "Use SUM(Sales_Sheet) for totals of sales sheet.",
      "To resolve names, join on: uploaded_byId = Users.Id; dealerId = Dealer.id.",
      "Do not select email1; they are sensitive or may hold very large content."
