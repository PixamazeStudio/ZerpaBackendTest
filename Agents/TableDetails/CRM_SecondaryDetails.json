      "notional_area"
    ],
    "default_sort": "created_date DESC",
    "avoid_columns": [],
    "query_notes": [
      "The database is MySQL/MariaDB; use MySQL syntax and the exact name CRM_SecondaryDetails (identifiers can be case-sensitive).",
      "Always filter is_deleted = 0 unless deleted records are explicitly requested.",
      "Use COUNT(DISTINCT id) when counting crm secondary detail records; joins can duplicate rows.",
      "Use SUM(quantity) for totals of quantity.",
      "To resolve names, join on: productsid = Products.id; CRM_SecondaryOrderHeaderid = CRM_SecondaryOrder.id."
    ]
