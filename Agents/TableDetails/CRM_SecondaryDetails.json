  "business_rules": [
    "Deleted records (is_deleted = 1) should normally be excluded from reporting.",
    "created_date is the preferred date column for period-based reporting.",
    "Use quantity / notional_area for monetary or quantity totals.",
    "Join to CRM Secondary Order, Products through the foreign key columns to resolve names."
  ],
  "common_filters": [
    "created_date",
    "productsid",
    "CRM_SecondaryOrderHeaderid",
    "is_deleted",
    "product_name"
  ],
  "common_metrics": [
    {
      "name": "Record Count",
      "formula": "COUNT(DISTINCT id)"
    },
    {
      "name": "Total Quantity",
      "formula": "SUM(quantity)"
    },
    {
      "name": "Total Notional Area",
      "formula": "SUM(notional_area)"
    },
    {
      "name": "Average Quantity per crm secondary detail",
      "formula": "SUM(quantity) / COUNT(DISTINCT id)"
    }
  ],
  "common_queries": [
