    "query_notes": [
      "The database is MySQL/MariaDB; use MySQL syntax and the exact name ClubbingHeader (identifiers can be case-sensitive).",
      "Always filter is_deleted = 0 unless deleted records are explicitly requested.",
      "Use COUNT(DISTINCT id) when counting clubbing header records; joins can duplicate rows.",
      "Use SUM(total_price) for totals of total price.",
      "To resolve names, join on: dispatched_confirmed_byId = Users.Id; regionid = Region.id; areaid = Area.id; FactoryApprovedById = Users.Id; truckid = Trucks.id."
    ]
  }
