  "business_rules": [
    "Deleted records (is_deleted = 1) should normally be excluded from reporting.",
    "date is the preferred date column for period-based reporting.",
    "Use pending_amount for monetary or quantity totals.",
    "Join to Dealer through the foreign key columns to resolve names."
  ],
  "common_filters": [
    "date",
    "dealerId",
    "is_deleted",
    "party_name"
  ],
  "common_metrics": [
    {
      "name": "Record Count",
      "formula": "COUNT(DISTINCT id)"
    },
    {
      "name": "Total Pending Amount",
      "formula": "SUM(pending_amount)"
    },
    {
      "name": "Average Pending Amount per outstanding",
      "formula": "SUM(pending_amount) / COUNT(DISTINCT id)"
    }
  ],
