    "query_notes": [
      "The database is MySQL/MariaDB; use MySQL syntax and the exact name IncentiveBMTarget (identifiers can be case-sensitive).",
      "Always filter is_deleted = 0 unless deleted records are explicitly requested.",
      "Use COUNT(DISTINCT id) when counting incentive bm target records; joins can duplicate rows.",
      "Use SUM(target_points) for totals of target points.",
      "To resolve names, join on: BM_userId = Users.Id; productId = IncentiveProductWisPoints.id; financial_yearid = FinancialYears.id."
