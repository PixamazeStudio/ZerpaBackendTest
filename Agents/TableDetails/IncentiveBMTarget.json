  "business_rules": [
    "Deleted records (is_deleted = 1) should normally be excluded from reporting.",
    "created_date is the preferred date column for period-based reporting.",
    "Use target_points / target_points2 for monetary or quantity totals.",
    "Join to Financial Years, Incentive Product Wis Points, Users through the foreign key columns to resolve names."
  ],
  "common_filters": [
    "created_date",
    "BM_userId",
    "productId",
    "financial_yearid",
    "is_deleted"
  ],
  "common_metrics": [
    {
      "name": "Record Count",
      "formula": "COUNT(DISTINCT id)"
    },
    {
      "name": "Total Target Points",
      "formula": "SUM(target_points)"
    },
    {
      "name": "Total Target Points2",
      "formula": "SUM(target_points2)"
    },
    {
      "name": "Total Target Points3",
      "formula": "SUM(target_points3)"
    },
    {
      "name": "Average Target Points per incentive bm target",
      "formula": "SUM(target_points) / COUNT(DISTINCT id)"
    }
  ],
