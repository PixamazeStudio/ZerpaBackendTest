  "business_rules": [
    "Deleted records (is_deleted = 1) should normally be excluded from reporting.",
    "created_date is the preferred date column for period-based reporting.",
    "Use quantity for monetary or quantity totals.",
    "Join to Department, Factory Section, Lot Space, Parking Space through the foreign key columns to resolve names.",
    "MLP is defined in the EF Core model but was not found in the connected database, so it may not be deployed there."
  ],
