  "common_metrics": [
    {
      "name": "Record Count",
      "formula": "COUNT(DISTINCT id)"
    },
    {
      "name": "Total Quantity",
      "formula": "SUM(quantity)"
    },
    {
      "name": "Average Quantity per mlp",
      "formula": "SUM(quantity) / COUNT(DISTINCT id)"
    }
