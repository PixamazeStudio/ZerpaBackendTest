  "business_rules": [
    "Deleted records (is_deleted = 1) should normally be excluded from reporting.",
    "Approval state is tracked with is_approved, is_rejected; a record with neither flag set is typically still pending.",
    "is_closed = 1 marks the record as closed.",
    "created_date is the preferred date column for period-based reporting.",
    "Use net_amount / confirmed_amount for monetary or quantity totals.",
    "Columns approval_status classify the record; check the distinct values before filtering on them.",
    "vw_AccountTransferDetails is a database view: it is read-only and its rows are computed, so apply filters and a LIMIT when querying."
  ],
  "common_filters": [
    "created_date",
    "approval_status",
    "is_approved",
    "is_hold",
    "is_rejected",
    "code"
  ],
