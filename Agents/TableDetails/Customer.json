    ],
    "query_notes": [
      "The database is MySQL/MariaDB; use MySQL syntax and the exact name Customer (identifiers can be case-sensitive).",
      "Always filter is_deleted = 0 unless deleted records are explicitly requested.",
      "Use COUNT(DISTINCT Id) when counting customer records; joins can duplicate rows.",
      "To resolve names, join on: regionid = Region.id; areaid = Area.id; subareaid = SubArea.id; assigned_toId = Users.Id.",
      "Do not select address, email; they are sensitive or may hold very large content."
    ]
  }
