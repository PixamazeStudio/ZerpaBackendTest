  "business_rules": [
    "Deleted records (is_deleted = 1) should normally be excluded from reporting.",
    "Approval state is tracked with is_approved, is_rejected; a record with neither flag set is typically still pending.",
    "created_date is the preferred date column for period-based reporting.",
    "Use total_notional_area / total_quantity for monetary or quantity totals.",
    "Columns status, primary_type classify the record; check the distinct values before filtering on them.",
    "Join to Client, Dealer, Users through the foreign key columns to resolve names."
  ],
  "common_filters": [
    "created_date",
    "supplied_byid",
    "primary_decision_makerId",
    "branchid",
    "areaid",
    "status",
    "primary_type",
    "is_deleted",
    "is_approved",
    "is_rejected",
    "secondary_order_code"
  ],
  "common_metrics": [
    {
      "name": "Record Count",
      "formula": "COUNT(DISTINCT id)"
    },
    {
      "name": "Total Discount From MRP",
      "formula": "SUM(discount_from_MRP)"
    },
    {
      "name": "Total Notional Area",
      "formula": "SUM(total_notional_area)"
    },
    {
      "name": "Total Quantity",
      "formula": "SUM(total_quantity)"
    },
    {
      "name": "Average Discount From MRP per crm secondary order",
      "formula": "SUM(discount_from_MRP) / COUNT(DISTINCT id)"
    }
  ],
