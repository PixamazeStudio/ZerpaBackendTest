    "avoid_columns": [],
    "query_notes": [
      "The database is MySQL/MariaDB; use MySQL syntax and the exact name CRM_SecondaryOrder (identifiers can be case-sensitive).",
      "Always filter is_deleted = 0 unless deleted records are explicitly requested.",
      "Use COUNT(DISTINCT id) when counting crm secondary order records; joins can duplicate rows.",
      "Use SUM(total_notional_area) for totals of total notional area.",
      "To resolve names, join on: supplied_byid = Dealer.id; primary_decision_makerId = Client.Id; branchid = Users.Id; areaid = Users.Id; secondary_typeId = Users.Id."
    ]
  }
