    "query_notes": [
      "The database is MySQL/MariaDB; use MySQL syntax and the exact name Users (identifiers can be case-sensitive).",
      "Always filter IsDeleted = 0 unless deleted records are explicitly requested.",
      "Use COUNT(DISTINCT Id) when counting user records; joins can duplicate rows.",
      "To resolve names, join on: Roleid = UserRoles.id; internal_departmentid = InternalDepartments.id.",
      "Do not select Email, Password, DateOfBirth, Address, image, PhoneNumber and others; they are sensitive or may hold very large content."
    ]
