    "query_notes": [
      "The database is MySQL/MariaDB; use MySQL syntax and the exact name ObservationReport (identifiers can be case-sensitive).",
      "Always filter is_deleted = 0 unless deleted records are explicitly requested.",
      "Use COUNT(DISTINCT Id) when counting observation report records; joins can duplicate rows.",
      "To resolve names, join on: complaintsheaderid = ComplaintsHeader.id.",
      "Do not select Address, file_path, base64_image; they are sensitive or may hold very large content."
