  "business_rules": [
    "Deleted records (is_deleted = 1) should normally be excluded from reporting.",
    "uploaded_date is the preferred date column for period-based reporting.",
    "Use n_a / career_na for monetary or quantity totals.",
    "Columns category classify the record; check the distinct values before filtering on them.",
    "Join to Users through the foreign key columns to resolve names."
  ],
