    ],
    "query_notes": [
      "The database is MySQL/MariaDB; use MySQL syntax and the exact name WarrantyCard (identifiers can be case-sensitive).",
      "Always filter is_deleted = 0 unless deleted records are explicitly requested.",
      "Use COUNT(DISTINCT id) when counting warranty card records; joins can duplicate rows.",
      "To resolve names, join on: dealerid = Dealer.id; productid = Products.id; warranty_typeid = WarrantyCardType.id.",
      "Do not select contact_number, customer_address, customer_email, card_file; they are sensitive or may hold very large content."
    ]
  }
