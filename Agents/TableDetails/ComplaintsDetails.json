  "common_metrics": [
    {
      "name": "Record Count",
      "formula": "COUNT(DISTINCT id)"
    },
    {
      "name": "Total Qty Supplied",
      "formula": "SUM(qty_supplied)"
    },
    {
      "name": "Total Qty On Claim",
      "formula": "SUM(qty_on_claim)"
    },
    {
      "name": "Total Value On Claim",
      "formula": "SUM(value_on_claim)"
    },
    {
      "name": "Average Qty Supplied per complaints detail",
      "formula": "SUM(qty_supplied) / COUNT(DISTINCT id)"
    }
  ],
