  "business_rules": [
    "manufacturedate is the preferred date column for period-based reporting.",
    "Use value_on_claim / suggested_claim_value for monetary or quantity totals.",
    "Columns product_name_type classify the record; check the distinct values before filtering on them.",
    "Join to Complaints Header through the foreign key columns to resolve names."
  ],
