      "name": "Record Count",
      "formula": "COUNT(DISTINCT id)"
    },
    {
      "name": "Total Items",
      "formula": "SUM(total_items)"
    },
    {
      "name": "Average Total Price",
      "formula": "AVG(total_price)"
    },
    {
      "name": "Total Weight",
      "formula": "SUM(total_weight)"
    },
    {
      "name": "Average Total Items per indent header",
      "formula": "SUM(total_items) / COUNT(DISTINCT id)"
    }
  ],
