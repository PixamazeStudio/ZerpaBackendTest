  "business_rules": [
    "Deleted records (is_deleted = 1) should normally be excluded from reporting.",
    "created_date is the preferred date column for period-based reporting.",
    "Use total_items / total_price for monetary or quantity totals.",
    "Columns factory_status, indent_status, priority classify the record; check the distinct values before filtering on them.",
    "Join to Users through the foreign key columns to resolve names."
  ],
