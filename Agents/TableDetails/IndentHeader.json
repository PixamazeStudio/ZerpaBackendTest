    "can_query": true,
    "preferred_date_column": "created_date",
    "preferred_amount_columns": [
      "total_items",
      "total_price"
    ],
    "default_sort": "created_date DESC",
    "avoid_columns": [
      "filepath",
      "dispatch_address",
      "shipping_address",
      "Initialfilepath"
    ],
    "query_notes": [
      "The database is MySQL/MariaDB; use MySQL syntax and the exact name IndentHeader (identifiers can be case-sensitive).",
      "Always filter is_deleted = 0 unless deleted records are explicitly requested.",
      "Use COUNT(DISTINCT id) when counting indent header records; joins can duplicate rows.",
      "Use SUM(total_items) for totals of total items.",
      "To resolve names, join on: branch_approved_byId = Users.Id; credit_approved_byId = Users.Id; vp_approved_byId = Users.Id; director_approved_byId = Users.Id; areaid = Area.id.",
      "Do not select filepath, dispatch_address, shipping_address, Initialfilepath; they are sensitive or may hold very large content."
    ]
  }
