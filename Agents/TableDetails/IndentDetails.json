  "business_rules": [
    "Deleted records (is_deleted = 1) should normally be excluded from reporting.",
    "Use total_amount / total_weight for monetary or quantity totals.",
    "Join to Indent Header, Products through the foreign key columns to resolve names."
  ],
  "common_filters": [
    "indent_headerid",
    "productid",
    "is_deleted"
  ],
  "common_metrics": [
    {
      "name": "Record Count",
      "formula": "COUNT(DISTINCT id)"
    },
    {
      "name": "Total Qty",
      "formula": "SUM(qty)"
    },
    {
      "name": "Average Rate",
      "formula": "AVG(rate)"
    },
    {
      "name": "Total Amount",
      "formula": "SUM(total_amount)"
    },
    {
      "name": "Average Qty per indent detail",
      "formula": "SUM(qty) / COUNT(DISTINCT id)"
    }
  ],
