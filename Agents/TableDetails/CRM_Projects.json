  "common_metrics": [
    {
      "name": "Record Count",
      "formula": "COUNT(DISTINCT Id)"
    },
    {
      "name": "Total Expected Qty",
      "formula": "SUM(expected_qty)"
    },
    {
      "name": "Average Expected Qty per crm project",
      "formula": "SUM(expected_qty) / COUNT(DISTINCT Id)"
    }
  ],
