  "business_rules": [
    "Deleted records (is_deleted = 1) should normally be excluded from reporting.",
    "Approval state is tracked with is_approved, is_rejected; a record with neither flag set is typically still pending.",
    "created_date is the preferred date column for period-based reporting.",
    "Use total / total_influencer_wise_planned for monetary or quantity totals.",
    "Join to Users through the foreign key columns to resolve names."
  ],
  "common_filters": [
    "created_date",
    "selectedUserId",
    "is_deleted",
    "is_editable",
    "is_completed",
    "week_name"
  ],
  "common_metrics": [
    {
      "name": "Record Count",
      "formula": "COUNT(DISTINCT id)"
    },
    {
      "name": "Total",
      "formula": "SUM(total)"
    },
    {
      "name": "Average Average Calls",
      "formula": "AVG(average_calls)"
    },
    {
      "name": "Total No Of Fl Met This Week",
      "formula": "SUM(no_of_fl_met_this_week)"
    },
    {
      "name": "Average Total per weakly planner header",
      "formula": "SUM(total) / COUNT(DISTINCT id)"
    }
  ],
  "common_queries": [
    "Weakly Planner Headers by month",
