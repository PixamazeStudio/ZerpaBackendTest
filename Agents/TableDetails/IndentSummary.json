  "data_quality": {
    "expected_unique_columns": [],
    "nullable_columns": [],
    "known_issues": [
      "total_items, total_notional_area, total_trucks, total_price are stored as floating point, so sums can carry small rounding differences.",
      "total_notional_area, total_trucks, total_qty, invoice_notional_area are nullable; use COALESCE when summing or comparing.",
      "Views expose no primary key or nullability guarantees; rows may repeat depending on the view definition."
    ]
  },
