            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/Region?limit=10&offset=0",
              "host": ["{{base_url}}"],
              "path": ["Region"],
              "query": [
                {
                  "key": "fromdate",
                  "value": "2025-08-01",
                  "disabled": true
                },
                {
                  "key": "todate",
                  "value": "2025-08-08",
                  "disabled": true
                },
                {
                  "key": "inputText",
                  "value": "north",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Retrieve a paginated list of regions with optional filtering"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "GET",
                "header": [
